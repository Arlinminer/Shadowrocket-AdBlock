[URL Rewrite]
# ---- 开屏广告接口，包含静态图片和视频开屏配置 ----
# 网易云：精确媒体素材主机由上面的Rule拦截
# 开屏广告接口（部分版本的 api / eapi / xeapi）
^https?:\/\/(?:ipv4|interface[0-9]?)\.music\.163\.com\/(?:api|eapi|xeapi)\/ad(?:[\/?]|$) - reject-dict
# 启动时的 VIP 促销弹窗，非会员鉴权
^https?:\/\/(?:ipv4|interface[0-9]?)\.music\.163\.com\/(?:api|eapi)\/sp\/flow\/popup\/query(?:[\/?]|$) - reject-200
# 若仍出现黑胶 SVIP 启动动画，可能是会员自定义启动图或应用缓存，不能仅凭截图认定以上接口命中
# QQ音乐：启动图素材 + 广告接口
^https?:\/\/y\.gtimg\.cn\/music\/common\/upload\/t_splash_info\/ - reject
^https?:\/\/music\.y\.qq\.com\/maproxy\/getPbCompressAd - reject-dict
# 高德开屏
^https?:\/\/amap-aos-info-nogw\.amap\.com\/ws\/aos\/alimama\/splash_screen_rt - reject-dict
^https?:\/\/m\d\.amap\.com\/ws\/shield\/dsp\/app\/startup\/init\? - reject-dict
# B站开屏素材/广告接口
^https?:\/\/upos-sz-static\.bilivideo\.com\/ssaxcode\/\w{2}\/\w{2}\/\w{32}-1-SPLASH - reject
^https?:\/\/api\.bilibili\.com\/x\/mengqi\/v\d\/resource\? - reject-dict
# 微博开屏与广告接口
^https?:\/\/bootpreload\.uve\.weibo\.com\/v1\/ad\/preload - reject-dict
^https?:\/\/api\.weibo\.cn\/2\/ad\/ - reject-dict
# 知乎开屏
^https?:\/\/api\.zhihu\.com\/commercial_api\/(?:banners_v\d\/app_topstory_banner|launch_v|real_time_launch_v) - reject-dict
^https?:\/\/api\.zhihu\.com\/ad(?:\/|\?) - reject-dict
# 小红书专用推广接口
^https?:\/\/www\.xiaohongshu\.com\/api\/sns\/v\d+\/ads\/resource - reject-dict
^https?:\/\/www\.xiaohongshu\.com\/api\/marketing\/box\/trigger\? - reject-dict
# 淘宝和闲鱼推广、开屏
^https?:\/\/acs\.m\.taobao\.com\/gw\/mtop\.alibaba\.advertisementservice\.getadv - reject-dict
^https?:\/\/acs\.m\.taobao\.com\/gw\/mtop\.o2o\.ad\.gateway\.get - reject-dict
^https?:\/\/(?:g-)?acs\.m\.goofish\.com\/gw\/mtop\.taobao\.idlecommerce\.splash - reject-dict
^https?:\/\/(?:g-)?acs\.m\.goofish\.com\/gw\/mtop\.taobao\.idle\.live\.home\.ads\.material\.get - reject-dict
# 京东推广接口
^https?:\/\/api\.m\.jd\.com\/client\.action\?functionId=(?:xview2Config|queryMaterialAdverts|apollo_style) - reject-200
# 美团广告图，仅精确素材子目录
^https?:\/\/img\.meituan\.net\/bizad - reject-img
^https?:\/\/img\.meituan\.net\/adunion\/ - reject-img
# 拼多多开屏/弹窗
^https?:\/\/api\.(?:pinduoduo|yangkeduo)\.com\/api\/cappuccino\/splash - reject-dict
^https?:\/\/api\.pinduoduo\.com\/api\/(?:aquarius\/hungary\/global\/app_popup|flow\/hungary\/window\/global) - reject-dict
# 中国移动 / 联通开屏
^https?:\/\/(?:client\.)?app(?:\.coc)?\.10086\.cn\/biz-orange\/DN\/init\/startInit - reject-dict
^https?:\/\/m\.client\.10010\.com\/mobileService\/(?:activity|customer)\/(?:get_client_adv|get_startadv) - reject-dict
# 网页广告：依靠广告域名拦截；不修改普通网页JS/CSS

[MITM]
# 必须%APPEND%，避免覆盖现有模块的hostname
hostname = %APPEND% ipv4.music.163.com, interface.music.163.com, interface1.music.163.com, interface2.music.163.com, interface3.music.163.com, interface9.music.163.com, y.gtimg.cn, music.y.qq.com, amap-aos-info-nogw.amap.com, m*.amap.com, upos-sz-static.bilivideo.com, api.bilibili.com, bootpreload.uve.weibo.com, api.weibo.cn, api.zhihu.com, www.xiaohongshu.com, acs.m.taobao.com, acs.m.goofish.com, g-acs.m.goofish.com, api.m.jd.com, img.meituan.net, api.pinduoduo.com, api.yangkeduo.com, app.10086.cn, client.app.10086.cn, app.coc.10086.cn, client.app.coc.10086.cn, m.client.10010.com
