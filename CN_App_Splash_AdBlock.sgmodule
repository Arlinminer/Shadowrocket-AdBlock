#!name=开屏广告
#!desc=去除开屏广告
#!author=Arlinminer
#!category=广告拦截
#!date=2026-11-21

# 配合 Johnshall「国内外划分 + 去广告」主配置使用。
# 本模块只补充 App 专属广告接口，不提供分流，也不复制庞大的通用域名黑名单。
# 适用于 Shadowrocket；URL Rewrite 需开启 HTTPS 解密并信任本机 CA。
# 如已安装旧的综合去广告/喜马拉雅专用模块，请先禁用旧模块避免冲突。
# 重要：本地缓存广告、内置动画、证书固定及新版本未知接口未必能拦截。
# 不拦截整个 ximalaya.com / music.163.com / xunlei.com / xmcdn.com / 126.net，
# 避免影响播放、下载、登录及会员功能。
# 规则以公开项目线索和用户实际日志为依据，未在各 App 版本逐一实测。
# 来源：
# https://github.com/TG-Twilight/AWAvenue-Ads-Rule/issues/109
# https://github.com/hwind2021/QuantumultX-Profile-CN
# https://github.com/letswish/Shadowrocket-Module
# https://github.com/vhvg/Surge-2
# https://github.com/gys619/surge-tools
# https://github.com/ihxperfect/loon-plugin

[Rule]
# ========== 喜马拉雅 ==========
DOMAIN,adse.ximalaya.com,REJECT
DOMAIN,adse.wsa.ximalaya.com,REJECT
DOMAIN,adsebs.ximalaya.com,REJECT
DOMAIN,adse.test.ximalaya.com,REJECT
DOMAIN,ad.ximalaya.com,REJECT
DOMAIN,adbs.ximalaya.com,REJECT
DOMAIN,adbehavior.wsa.ximalaya.com,REJECT
# ========== 网易云音乐 ==========
DOMAIN,iadmat.nosdn.127.net,REJECT
DOMAIN,iadmatapk.nosdn.127.net,REJECT
DOMAIN,iadmusicmat.music.126.net,REJECT
DOMAIN,iadmusicmatvideo.music.126.net,REJECT
DOMAIN,admusicpic.music.126.net,REJECT
DOMAIN,ad.bn.netease.com,REJECT
# ========== 迅雷 ==========
DOMAIN,adsp.xunlei.com,REJECT
DOMAIN,ad.xunlei.com,REJECT
DOMAIN,advert.xunlei.com,REJECT
# 可能涉及统计上报，单独保守处理广告素材接口，不封锁其他下载域名
# ========== 常见国内 App：仅广告专用域名 ==========
# B站
DOMAIN,cm.ad.bilibili.com,REJECT
DOMAIN,cm.adcommon.bilibili.com,REJECT
# QQ音乐 / 酷狗
DOMAIN,ad.tencentmusic.com,REJECT
DOMAIN,adcdn.tencentmusic.com,REJECT
DOMAIN,tmead.y.qq.com,REJECT
DOMAIN,ads.service.kugou.com,REJECT
# 知乎 / 微博
DOMAIN,sugar.zhihu.com,REJECT
DOMAIN,adimg.uve.weibo.com,REJECT
# 小红书（广告素材专用主机）
DOMAIN,ads-img-qc.xhscdn.com,REJECT
DOMAIN,ads-img-al.xhscdn.com,REJECT
DOMAIN,ads-video-qc.xhscdn.com,REJECT
DOMAIN,ads-video-al.xhscdn.com,REJECT
# 高德
DOMAIN,optimus-ads.amap.com,REJECT
# 其他
DOMAIN,ad.qingting.fm,REJECT
DOMAIN,ad.maoyan.com,REJECT

[URL Rewrite]
# ========== 喜马拉雅 ==========
# 常见广告实时接口：只匹配广告专属路径，不封锁通用 API
^https?:\/\/[^\/]+\.ximalaya\.com\/api\/v[0-9]+\/adRealTime(?:[/?]|$) - reject-200
^https?:\/\/[^\/]+\.ximalaya\.com\/(?:outadservice|ting\/preload)\/ - reject-200

# ========== 网易云音乐 ==========
# 用户抓包确认曾命中的广告加载接口 (2026-11-11)
^https?:\/\/(?:ipv4|interface[0-9]?)\.music\.163\.com\/(?:api|eapi|xeapi)\/ad\/loading\/bidget(?:[/?]|$) - reject-dict
# 其他明确位于 /ad/ 下的接口，只清空广告响应
^https?:\/\/(?:ipv4|interface[0-9]?)\.music\.163\.com\/(?:api|eapi|xeapi)\/ad\/(?:get|load|show|list|resource|splash)(?:[/?]|$) - reject-dict
# ========== 迅雷 ==========
# 限定广告路径；不屏蔽 api-shoulei-ssl 整个服务主机
^https?:\/\/api-shoulei-ssl\.xunlei\.com\/(?:advert|ad\/slots)(?:[/?]|$) - reject-200
^https?:\/\/(?:adsp|advert)\.xunlei\.com\/ - reject-200
# 公开规则记录的迅雷广告位批量请求
^https?:\/\/api-shoulei-ssl\.xunlei\.com\/flowhub\/v[0-9]+\/slots:batchGet(?:[/?]|$) - reject-200
# 迅雷推广图片素材，仅在专用 advert 路径处理
^https?:\/\/images\.client\.vip\.xunlei\.com\/.+\/advert\/ - reject-200
# ========== 其他常见开屏接口 ==========
# 知乎
^https?:\/\/api\.zhihu\.com\/commercial_api\/(?:launch_v2|real_time_launch_v2)(?:[/?]|$) - reject-dict
# 高德
^https?:\/\/amap-aos-info-nogw\.amap\.com\/ws\/aos\/alimama\/splash_screen_rt(?:[/?]|$) - reject-dict
# B站
^https?:\/\/api\.bilibili\.com\/x\/mengqi\/v[0-9]+\/resource(?:[/?]|$) - reject-dict
# 淘宝
^https?:\/\/acs\.m\.taobao\.com\/gw\/mtop\.alibaba\.advertisementservice\.getadv(?:[/?]|$) - reject-dict
# 闲鱼
^https?:\/\/(?:g-)?acs\.m\.goofish\.com\/gw\/mtop\.taobao\.idlecommerce\.splash(?:[./?]|$) - reject-dict
# 京东
^https?:\/\/api\.m\.jd\.com\/client\.action\?functionId=(?:xview2Config|queryMaterialAdverts)(?:&|$) - reject-200

[MITM]
# 限定需要 URL 重写的主机；不解密 Apple / 银行 / 全站音视频 CDN
hostname = %APPEND% *.ximalaya.com, images.client.vip.xunlei.com, ipv4.music.163.com, interface.music.163.com, interface1.music.163.com, interface2.music.163.com, interface3.music.163.com, interface6.music.163.com, interface9.music.163.com, api-shoulei-ssl.xunlei.com, adsp.xunlei.com, advert.xunlei.com, api.zhihu.com, amap-aos-info-nogw.amap.com, api.bilibili.com, acs.m.taobao.com, acs.m.goofish.com, g-acs.m.goofish.com, api.m.jd.com
